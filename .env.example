# Required: NVIDIA API key for model access
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA model ID
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: enables web search/research features
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: enables Telegram integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here
